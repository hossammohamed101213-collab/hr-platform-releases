{
  "name": "hr-platform",
  "productName": "منصة شؤون الموظفين",
  "version": "5.9.3",
  "description": "منصة مغلقة لإدارة شؤون الموظفين — تعمل بدون إنترنت",
  "main": "main.js",
  "author": "Hossam",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:win-arm": "electron-builder --win --arm64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "publish": "electron-builder --publish always",
    "keygen": "node tools/keygen.js"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "playwright": "^1.50.0"
  },
  "build": {
    "appId": "com.hossam.hrplatform",
    "productName": "HR Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sql.js/package.json",
      "!node_modules/chart.js/**",
      "license.js",
      "vendor.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HR-Platform-Setup-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "portable": {
      "artifactName": "HR-Platform-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "منصة شؤون الموظفين",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025",
      "differentialPackage": false
    },
    "publish": {
      "provider": "github",
      "owner": "sevencargoae-png",
      "repo": "hr-platform-releases",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "HR-Platform-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Hossam <hossam.mohamed101213@gmail.com>",
      "artifactName": "HR-Platform-${version}-linux-${arch}.${ext}"
    }
  }
}